<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>美食挑选抽奖</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #ff8a80, #ffccbc);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-family: "Microsoft Yahei", sans-serif;
            padding:20px;
        }
        h1 {
            color:#fff;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
            margin-bottom:30px;
        }
        .prize-box-wrap{
            max-width: 520px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap:12px;
            margin-bottom:30px;
        }
        .prize-item{
            background:#fff;
            border-radius:12px;
            padding:12px 8px;
            text-align:center;
            border:3px solid transparent;
            transition: all 0.15s;
        }
        /* 挑选高亮动画 */
        .prize-item.active{
            border-color:#ff3d00;
            box-shadow: 0 0 16px #ff5722;
            transform: scale(1.08);
        }
        .prize-item img{
            width:50px;
            height:50px;
            object-fit:contain;
            margin-bottom:6px;
        }
        .prize-item .name{
            font-size:14px;
            color:#333;
        }
        #startBtn{
            padding:14px 48px;
            font-size:20px;
            border:none;
            background:#ff4757;
            color:#fff;
            border-radius:50px;
            cursor:pointer;
            box-shadow:0 4px 14px rgba(255,71,87,0.4);
        }
        #startBtn:disabled{
            background:#aaa;
            cursor:not-allowed;
        }
        #startBtn:active{
            transform:scale(0.96);
        }

        /*中奖弹窗*/
        .mask{
            position:fixed;
            inset:0;
            background:rgba(0,0,0,0.6);
            display:none;
            align-items:center;
            justify-content:center;
            z-index:99;
        }
        .popup{
            background:#fff;
            padding:40px 30px;
            border-radius:18px;
            text-align:center;
            min-width:300px;
        }
        .popup h2{
            color:#ff4757;
            margin-bottom:16px;
        }
        #popImg{
            width:100px;
            height:100px;
            object-fit:contain;
            margin:10px auto;
        }
        .pop-name{
            font-size:24px;
            margin:12px 0 24px;
        }
        #closePop{
            padding:10px 30px;
            background:#ff4757;
            color:#fff;
            border:none;
            border-radius:8px;
            font-size:17px;
            cursor:pointer;
        }
    </style>
</head>
<body>
    <h1>🍲幸运美食抽奖🍢</h1>
    <div class="prize-box-wrap" id="boxWrap"></div>
    <button id="startBtn">开始抽奖</button>

    <div class="mask" id="mask">
        <div class="popup">
            <h2>🎉恭喜抽中</h2>
            <img id="popImg" alt="">
            <div class="pop-name" id="popName"></div>
            <button id="closePop">确定</button>
        </div>
    </div>

<script>
// ===================== 修改奖品在这里 =====================
const prizeList = [
    {name:"炒季", img:"https://img07.xiuxianshipin.com/storage/uploads/2025/12/29/698e689ce48b11f082f6a2f77a0b475b.jpg"},
    {name:"麻辣烫", img:"https://bkimg.cdn.bcebos.com/pic/d4628535e5dde71190efb20d0bb6d91b9d16fcfacb8c?x-bce-process=image/format,f_auto/quality,Q_70/resize,m_lfit,limit_1,w_536"},
    {name:"饼夹菜", img:"https://pic3.zhimg.com/v2-1084ab9b01be84224851edaedbc766a6_1440w.jpg"},
    {name:"如意混沌", img:"https://bkimg.cdn.bcebos.com/pic/f9198618367adab44aed63802385a41c8701a08b4eec?x-bce-process=image/format,f_auto/quality,Q_70/resize,m_lfit,limit_1,w_536"},
    {name:"麻辣香锅", img:"https://bkimg.cdn.bcebos.com/pic/2fdda3cc7cd98d1001e9d8eda167af0e7bec55e73aec?x-bce-process=image/format,f_auto/quality,Q_70/resize,m_lfit,limit_1,w_536"},
    {name:"擂饭", img:"https://32939903.s21i.faiusr.com/2/ABUIABACGAAgoeqHuQYo2M2d9QEwoAY42AQ!400x400.jpg"},
    {name:"煲仔饭", img:"https://bkimg.cdn.bcebos.com/pic/d01373f082025aafa40fd9a9beb1bc64034f78f0ac07?x-bce-process=image/format,f_auto/quality,Q_70/resize,m_lfit,limit_1,w_536"},
	{name:"新疆炒米粉", img:"https://admin.huaxx.cn/Uploads/2025-08-22/68a7fc98a8557.jpg"},
	{name:"过桥米线", img:"https://www.logosc.cn/uploads/output/2020/02/26/846cdd3af3985ebd627b79aeaee9c6de.jpg?t=1583207658"},
	{name:"浇头面", img:"https://33771673.s21i.faiusr.com/4/ABUIABAEGAAgmZHOygYo9I_iNzDEXjjMOg.png"},
	{name:"袁记云饺", img:"https://bkimg.cdn.bcebos.com/pic/aa64034f78f0f736afc36058cf0ea419ebc4b745b56d?x-bce-process=image/format,f_auto/quality,Q_70/resize,m_lfit,limit_1,w_536"},
	{name:"熊大爷包饺子", img:"https://tse3-mm.cn.bing.net/th/id/OIP-C.L3n-gELAdiSdD27yIdFcQQHaFj?w=197&h=180&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3"},
];

const boxWrap = document.getElementById('boxWrap');
const startBtn = document.getElementById('startBtn');
const mask = document.getElementById('mask');
const popImg = document.getElementById('popImg');
const popName = document.getElementById('popName');
const closePop = document.getElementById('closePop');

let itemDomList = [];
let isRunning = false;

//渲染奖品格子
function renderPrize(){
    boxWrap.innerHTML = '';
    itemDomList = [];
    prizeList.forEach((p,idx)=>{
        const div = document.createElement('div');
        div.className = 'prize-item';
        div.innerHTML = `<img src="${p.img}" alt=""><div class="name">${p.name}</div>`;
        boxWrap.appendChild(div);
        itemDomList.push(div);
    })
}
renderPrize();

// 清除所有高亮
function clearActive(){
    itemDomList.forEach(d=>d.classList.remove('active'));
}

startBtn.onclick = async function(){
    if(isRunning) return;
    isRunning = true;
    startBtn.disabled = true;
    clearActive();

    //最终中奖索引
    const targetIndex = Math.floor(Math.random() * prizeList.length);

    //挑选动画：速度由快慢慢减速，扫过奖品
    let speed = 60;
    let current = 0;
    let loopCount = 0;
    const maxLoop = 12;

    await new Promise(resolve=>{
        function tick(){
            clearActive();
            itemDomList[current].classList.add('active');

            // 接近目标，降低速度
            if(loopCount > maxLoop || (current === targetIndex && loopCount>6)){
                //定格在中奖项
                clearActive();
                itemDomList[targetIndex].classList.add('active');
                setTimeout(()=>{
                    resolve();
                },300);
                return;
            }

            //越往后间隔越大，减速
            speed = 60 + loopCount*35;
            current = (current+1) % prizeList.length;
            loopCount++;
            setTimeout(tick, speed);
        }
        tick();
    })

    //弹出结果
    const win = prizeList[targetIndex];
    popImg.src = win.img;
    popName.innerText = win.name;
    mask.style.display = 'flex';
    isRunning = false;
}

closePop.onclick = function(){
    mask.style.display = 'none';
    clearActive();
    startBtn.disabled = false;
}
</script>
</body>
</html>
